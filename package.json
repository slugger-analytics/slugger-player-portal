{
  "name": "available-player-portal",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@prisma/config": {
      "effect": "3.21.0"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:generate": "npm run db:generate -w @available-player-portal/api",
    "db:push": "npm run db:push -w @available-player-portal/api",
    "sync": "npm run sync -w @available-player-portal/api"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  }
}
