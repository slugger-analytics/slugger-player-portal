# App
NODE_ENV=development
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Next.js only: subpath hosting — set to your URL prefix so /_next assets resolve (see README).
# NEXT_PUBLIC_BASE_PATH=/player-portal

# Database — copy to repo root or apps/api/.env (both are loaded).
# Local dev (no Docker): install Postgres, create DB + user, then match them here, e.g.:
#   postgresql://USER:PASSWORD@localhost:5432/available_player_portal
# Or peer auth on Mac: postgresql://YOUR_MAC_USERNAME@localhost:5432/available_player_portal
DATABASE_URL=postgresql://user:password@localhost:5432/available_player_portal

# Standalone Auth (NextAuth — used when app is accessed directly, not via SLUGGER)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# SLUGGER Widget Integration
SLUGGER_API_BASE_URL=https://alpb-analytics.com
SLUGGER_WIDGET_ID=available-player-portal          # Must match widget_id registered in SLUGGER
NEXT_PUBLIC_SLUGGER_ORIGINS=https://alpb-analytics.com,http://localhost:3000

# Data Sources
MLB_TRANSACTION_FEED_URL=
MILB_TRANSACTION_FEED_URL=
BASEBALL_CUBE_BASE_URL=
BASEBALL_CUBE_API_KEY=
# Server-only Baseball Cube feed password (never NEXT_PUBLIC_ — never expose to browser)
TBC_FEED_PASSWORD=jhu$

# Optional: protect POST /sync (API) and the Next.js /api/sync proxy. If set, must match on both
# API and web server; Next forwards Authorization: Bearer <SYNC_INTERNAL_KEY>.
SYNC_INTERNAL_KEY=

# Optional: base URL for the API as seen from the Next.js server (defaults to NEXT_PUBLIC_API_URL)
INTERNAL_API_URL=


# Cron
CRON_TRANSACTION_SYNC=*/30 * * * *    # Every 30 min — must publish within 60 min of release
CRON_ALERT_DISPATCH=*/5 * * * *

# Email Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@available-player-portal.com

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

