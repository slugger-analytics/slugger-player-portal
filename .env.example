# App
NODE_ENV=development
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database — Aurora (player_portal on alpb-1)
# Retrieve the full connection string from SSM:
#   aws ssm get-parameter --name "/slugger/player-portal/database-url" --with-decryption --query "Parameter.Value" --output text --region us-east-2
DATABASE_URL=postgresql://player_portal_user:<password>@alpb-1.cluster-cx866cecsebt.us-east-2.rds.amazonaws.com:5432/player_portal

# Standalone Auth (NextAuth — used when app is accessed directly, not via SLUGGER)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# SLUGGER Widget Integration
SLUGGER_API_BASE_URL=https://alpb-analytics.com
SLUGGER_WIDGET_ID=available-player-portal
NEXT_PUBLIC_SLUGGER_ORIGINS=https://alpb-analytics.com,http://localhost:3000

# Data Sources
MLB_TRANSACTION_FEED_URL=
MILB_TRANSACTION_FEED_URL=
BASEBALL_CUBE_BASE_URL=
BASEBALL_CUBE_API_KEY=
TBC_FEED_PASSWORD=

# Optional: protect POST /sync (API) and the Next.js /api/sync proxy. If set, must match on both
# API and web server; Next forwards Authorization: Bearer <SYNC_INTERNAL_KEY>.
SYNC_INTERNAL_KEY=

# Optional: base URL for the API as seen from the Next.js server (defaults to NEXT_PUBLIC_API_URL)
INTERNAL_API_URL=

# Cron
CRON_TRANSACTION_SYNC=*/30 * * * *
CRON_ALERT_DISPATCH=*/5 * * * *

# Email Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@available-player-portal.com

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
