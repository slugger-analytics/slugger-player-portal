# =========================
# App
# =========================
NODE_ENV=development
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# =========================
# Database
# =========================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://user:password@localhost:5432/db_name

# =========================
# Auth (NextAuth)
# =========================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# =========================
# External APIs / Services
# =========================
API_KEY=your-api-key-here
TBC_FEED_PASSWORD=your-tbc-feed-password

# Optional: static/allowlisted egress for Baseball Cube fetches when AWS/CI IPs are blocked.
# Example: http://user:pass@proxy.example.com:8080
TBC_HTTPS_PROXY=

# =========================
# Email (SMTP)
# =========================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM=noreply@example.com

# Notification emails use SES when AWS_REGION and NOTIFICATION_EMAIL_FROM are set.
# Alternatively set NOTIFICATION_EMAIL_WEBHOOK_URL for a webhook adapter.
AWS_REGION=us-east-2
NOTIFICATION_EMAIL_FROM=notifications@example.com
NOTIFICATION_EMAIL_WEBHOOK_URL=

# =========================
# Optional / Internal
# =========================
SYNC_INTERNAL_KEY=optional-internal-key
INTERNAL_API_URL=http://localhost:4000
REMOTE_SYNC_INGEST_URL=https://www.alpb-analytics.com/widgets/player-portal/api/sync/ingest-raw

# Demo-only: when true, watching (belling) a player triggers immediate
# notification event creation and email send without waiting for sync.
DEMO_IMMEDIATE_NOTIFY_ON_WATCH=false