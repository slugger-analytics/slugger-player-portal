// Prisma schema for the Player Discovery Portal API.
// Tables mirror the SQL spec: players, transactions, batting_stats, pitching_stats, raw_feed_snapshots.
// Run: npm run db:generate / db:push / migrate from apps/api after changing this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Highest level of play (low → high); stored on `Player.experience_level`.
enum ExperienceLevel {
  ROOKIE
  A
  A_PLUS
  AA
  AAA
  MLB
}

/// Batting hand from TBC (`bats` / `bat` column): L, R, or B (both/switch).
enum BatHand {
  L
  R
  B
}

/// Throwing hand from TBC (`throws` / `throw` column).
enum ThrowHand {
  L
  R
}

// Core player row keyed by TBC player id (string). Optional age supports discovery filters.
model Player {
  id                 String           @id
  name               String
  position           String?
  team               String?
  status             String           @default("available")
  age                Int?
  experienceLevel    ExperienceLevel? @map("experience_level")
  bats               BatHand?         @map("bats")
  throws             ThrowHand?       @map("throws")
  /// Discovery list filter; set on upsert from isPlayerDiscoveryEligible (see playerEligibility.ts).
  discoveryEligible  Boolean          @default(true) @map("discovery_eligible")
  /// At least one profile-visible transaction (retired / released / free agent); maintained when transactions sync.
  hasProfileVisibleTransaction Boolean @default(false) @map("has_profile_visible_transaction")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  transactions Transaction[]
  battingStats BattingStat[]
  pitchingStats PitchingStat[]
  watchedPlayers WatchedPlayer[]
  notificationEvents NotificationEvent[]

  @@index([discoveryEligible, name])
  @@index([experienceLevel])
}

// Transaction feed lines; uniqueHash prevents duplicate rows from repeated sync runs.
model Transaction {
  id          Int      @id @default(autoincrement())
  playerId    String   @map("player_id")
  date        DateTime @db.Date
  type        String
  description String
  uniqueHash  String   @unique @map("unique_hash")
  createdAt   DateTime @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

// One row per player per season per team (batting).
model BattingStat {
  id       Int     @id @default(autoincrement())
  playerId String  @map("player_id")
  season   Int
  teamName String  @default("") @map("team_name")
  avg      Decimal @db.Decimal(5, 3)
  obp      Decimal @db.Decimal(5, 3)
  slg      Decimal @db.Decimal(5, 3)
  ops      Decimal @db.Decimal(5, 3)
  bb       Int     @default(0)
  hr       Int     @default(0)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season, teamName])
}

// One row per player per season per team (pitching).
model PitchingStat {
  id       Int     @id @default(autoincrement())
  playerId String  @map("player_id")
  season   Int
  teamName String  @default("") @map("team_name")
  g        Int     @default(0)
  era      Decimal @db.Decimal(5, 2)
  whip     Decimal @db.Decimal(5, 3)
  ip       Decimal @db.Decimal(6, 1)
  k        Int
  bb       Int     @default(0)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season, teamName])
}

// Append-only raw feed bodies for debugging and audit (each sync may insert new rows).
model RawFeedSnapshot {
  id         Int      @id @default(autoincrement())
  feedType   String   @map("feed_type")
  rawContent String   @map("raw_content")
  fetchedAt  DateTime @default(now()) @map("fetched_at")
}

model NotificationUser {
  id         String   @id @default(cuid())
  cognitoSub String   @unique @map("cognito_sub")
  email      String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  savedProfiles          SavedSearchProfile[]
  watchedPlayers         WatchedPlayer[]
  notificationEvents     NotificationEvent[]
  notificationDispatches NotificationDispatch[]
}

model SavedSearchProfile {
  id                 String   @id @default(cuid())
  notificationUserId String   @map("notification_user_id")
  name               String
  filters            Json
  onlyWithStats      Boolean  @default(false) @map("only_with_stats")
  rankingPreferences Json?    @map("ranking_preferences")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  notificationUser NotificationUser @relation(fields: [notificationUserId], references: [id], onDelete: Cascade)
  notificationEvents NotificationEvent[] @relation("SavedProfileEvents")

  @@index([notificationUserId])
}

model WatchedPlayer {
  id                 String   @id @default(cuid())
  notificationUserId String   @map("notification_user_id")
  playerId           String   @map("player_id")
  createdAt          DateTime @default(now()) @map("created_at")

  notificationUser NotificationUser @relation(fields: [notificationUserId], references: [id], onDelete: Cascade)
  player           Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([notificationUserId, playerId])
  @@index([notificationUserId])
}

enum NotificationEventType {
  PROFILE
  WATCHED
}

model NotificationEvent {
  id                    String                @id @default(cuid())
  notificationUserId    String                @map("notification_user_id")
  playerId              String                @map("player_id")
  type                  NotificationEventType
  dedupeKey             String                @unique @map("dedupe_key")
  savedSearchProfileId  String?               @map("saved_search_profile_id")
  payload               Json?
  createdAt             DateTime              @default(now()) @map("created_at")
  readAt                DateTime?             @map("read_at")

  notificationUser NotificationUser   @relation(fields: [notificationUserId], references: [id], onDelete: Cascade)
  player           Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  savedProfile     SavedSearchProfile? @relation("SavedProfileEvents", fields: [savedSearchProfileId], references: [id], onDelete: SetNull)

  dispatchItems NotificationDispatchItem[]

  @@index([notificationUserId, createdAt])
  @@index([notificationUserId, readAt])
}

model NotificationDispatch {
  id                 String   @id @default(cuid())
  notificationUserId String   @map("notification_user_id")
  syncRunKey         String   @map("sync_run_key")
  dispatchedAt       DateTime @default(now()) @map("dispatched_at")
  status             String
  errorMessage       String?  @map("error_message")

  notificationUser NotificationUser @relation(fields: [notificationUserId], references: [id], onDelete: Cascade)
  items            NotificationDispatchItem[]

  @@unique([notificationUserId, syncRunKey])
  @@index([syncRunKey])
}

model NotificationDispatchItem {
  dispatchId String @map("dispatch_id")
  eventId    String @map("event_id")

  dispatch NotificationDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  event    NotificationEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([dispatchId, eventId])
}
